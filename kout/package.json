{
  "name": "diwaniya-kout",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "tsx watch server/src/index.ts",
    "server:build": "esbuild server/src/index.ts server/src/botWorker.ts --bundle --platform=node --target=node20 --format=cjs --outdir=server/dist --out-extension:.js=.cjs --log-level=warning --log-override:empty-import-meta=silent",
    "server:start": "node server/dist/index.cjs",
    "loadtest": "tsx server/loadtest/loadtest.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.27",
    "@colyseus/sdk": "0.18.9",
    "@colyseus/ws-transport": "0.18.4",
    "@fontsource/cairo": "5.3.0",
    "@fontsource/reem-kufi": "5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.24.0",
    "tsx": "4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
